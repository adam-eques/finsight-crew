# Copy to .env and fill in the provider you want to use.
# finsight is provider-agnostic; set FINSIGHT_LLM_PROVIDER accordingly.

FINSIGHT_LLM_PROVIDER=anthropic
FINSIGHT_LLM_MODEL=claude-sonnet-4-20250514

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional web search provider
SERPER_API_KEY=

# Local, no API key required:
# FINSIGHT_LLM_PROVIDER=ollama
# FINSIGHT_LLM_MODEL=llama3.1
